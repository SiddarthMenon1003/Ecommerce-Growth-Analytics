{
  "name": "Growth Lab Dark",
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/themes/1.0.0/schema.json",

  "dataColors": [
    "#7FD3F7",
    "#4A90D9",
    "#D4B44A",
    "#E8737A",
    "#8B7CF6",
    "#B57EDC",
    "#FFFFFF",
    "#6B6B73"
  ],

  "good": "#7FD3F7",
  "neutral": "#D4B44A",
  "bad": "#E8737A",
  "maximum": "#7FD3F7",
  "center": "#4A90D9",
  "minimum": "#1B1B1F",
  "null": "#6B6B73",

  "firstLevelElements": "#FFFFFF",
  "secondLevelElements": "#9A9AA2",
  "thirdLevelElements": "#2F2F35",
  "fourthLevelElements": "#6B6B73",
  "background": "#1B1B1F",
  "secondaryBackground": "#26262B",
  "tableAccent": "#7FD3F7",
  "foreground": "#FFFFFF",
  "foregroundNeutralSecondary": "#9A9AA2",
  "foregroundNeutralTertiary": "#6B6B73",
  "hyperlink": "#7FD3F7",

  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#FFFFFF" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#FFFFFF" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 20, "color": "#FFFFFF" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 9, "color": "#9A9AA2" }
  },

  "visualStyles": {
    "*": {
      "*": {
        "*": [
          { "fontFamily": "Segoe UI", "fontSize": 9, "color": { "solid": { "color": "#FFFFFF" } } }
        ],
        "background": [
          { "show": true, "color": { "solid": { "color": "#26262B" } }, "transparency": 0 }
        ],
        "border": [
          { "show": true, "color": { "solid": { "color": "#3A3A40" } }, "radius": 6 }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "visualHeader": [
          { "show": true, "background": { "solid": { "color": "#26262B" } }, "foreground": { "solid": { "color": "#9A9AA2" } }, "border": { "solid": { "color": "#26262B" } }, "transparency": 0 }
        ],
        "visualTooltip": [
          { "show": true, "titleFontColor": { "solid": { "color": "#FFFFFF" } }, "valueFontColor": { "solid": { "color": "#FFFFFF" } }, "backgroundColor": { "solid": { "color": "#26262B" } }, "fontFamily": "Segoe UI", "fontSize": 9 }
        ],
        "title": [
          { "show": true, "titleWrap": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 11, "fontFamily": "Segoe UI Semibold", "alignment": "left", "background": { "solid": { "color": "#26262B" } } }
        ],
        "subTitle": [
          { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "fontFamily": "Segoe UI", "alignment": "left" }
        ],
        "padding": [
          { "left": 12, "right": 12, "top": 12, "bottom": 12 }
        ]
      }
    },

    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#1B1B1F" } }, "transparency": 0 } ],
        "outspace": [ { "color": { "solid": { "color": "#1B1B1F" } }, "transparency": 0 } ]
      }
    },

    "card": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#26262B" } } } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#3A3A40" } }, "radius": 6 } ],
        "labels": [ { "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 20, "fontFamily": "Segoe UI Semibold" } ],
        "categoryLabels": [ { "show": true, "color": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "fontFamily": "Segoe UI" } ],
        "wordWrap": [ { "show": true } ]
      }
    },

    "cardVisual": {
      "*": {
        "calloutValue": [ { "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 20, "fontFamily": "Segoe UI Semibold" } ],
        "background": [ { "show": true, "color": { "solid": { "color": "#26262B" } } } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#3A3A40" } }, "radius": 6 } ]
      }
    },

    "multiRowCard": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#26262B" } } } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#3A3A40" } }, "radius": 6 } ],
        "dataLabels": [ { "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 20, "fontFamily": "Segoe UI Semibold" } ],
        "categoryLabels": [ { "color": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9 } ],
        "cardTitle": [ { "color": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9 } ]
      }
    },

    "slicer": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#26262B" } } } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#3A3A40" } }, "radius": 6 } ],
        "header": [ { "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "background": { "solid": { "color": "#26262B" } }, "fontSize": 9, "fontFamily": "Segoe UI Semibold" } ],
        "items": [ { "fontColor": { "solid": { "color": "#9A9AA2" } }, "background": { "solid": { "color": "#26262B" } }, "fontSize": 9 } ],
        "selection": [ { "fontColor": { "solid": { "color": "#1B1B1F" } }, "background": { "solid": { "color": "#7FD3F7" } } } ]
      }
    },

    "columnChart": {
      "*": {
        "dataPoint": [ { "defaultColor": { "solid": { "color": "#7FD3F7" } }, "fill": { "solid": { "color": "#7FD3F7" } } } ],
        "categoryAxis": [ { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "gridlineShow": false } ],
        "valueAxis": [ { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#2F2F35" } }, "gridlineThickness": 1 } ],
        "labels": [ { "show": false, "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 } ]
      }
    },

    "barChart": {
      "*": {
        "dataPoint": [ { "defaultColor": { "solid": { "color": "#7FD3F7" } }, "fill": { "solid": { "color": "#7FD3F7" } } } ],
        "categoryAxis": [ { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "gridlineShow": false } ],
        "valueAxis": [ { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#2F2F35" } } } ],
        "labels": [ { "show": false, "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 } ]
      }
    },

    "lineChart": {
      "*": {
        "categoryAxis": [ { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "gridlineShow": false } ],
        "valueAxis": [ { "show": true, "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#2F2F35" } }, "gridlineThickness": 1 } ],
        "lineStyles": [ { "strokeWidth": 2, "showMarker": false } ]
      }
    },

    "tableEx": {
      "*": {
        "grid": [ { "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#2F2F35" } }, "rowPadding": 6, "outlineColor": { "solid": { "color": "#3A3A40" } } } ],
        "columnHeaders": [ { "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#26262B" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9 } ],
        "values": [ { "fontColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorPrimary": { "solid": { "color": "#26262B" } }, "fontColorSecondary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#1B1B1F" } }, "fontSize": 9 } ]
      }
    },

    "pivotTable": {
      "*": {
        "grid": [ { "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#2F2F35" } }, "rowPadding": 6 } ],
        "columnHeaders": [ { "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#26262B" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9 } ],
        "values": [ { "fontColorPrimary": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 } ]
      }
    },

    "actionButton": {
      "*": {
        "fill": [ { "show": true, "fillColor": { "solid": { "color": "#26262B" } }, "transparency": 0 } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#3A3A40" } }, "radius": 6 } ],
        "text": [ { "fontColor": { "solid": { "color": "#9A9AA2" } }, "fontSize": 9, "fontFamily": "Segoe UI" } ]
      }
    }
  }
}
