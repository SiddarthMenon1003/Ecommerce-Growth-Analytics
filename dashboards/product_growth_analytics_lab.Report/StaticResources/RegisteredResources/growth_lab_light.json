{
  "name": "Growth Lab Light",
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/themes/1.0.0/schema.json",
  "dataColors": [
    "#7B6CFF",
    "#2DD4BF",
    "#F2B134",
    "#F2727D",
    "#A78BFA",
    "#4CC2FF",
    "#46D39A",
    "#F178B6"
  ],
  "good": "#46D39A",
  "neutral": "#F2B134",
  "bad": "#F2727D",
  "maximum": "#7B6CFF",
  "center": "#4CC2FF",
  "minimum": "#232734",
  "null": "#6B7280",
  "firstLevelElements": "#F4F6FB",
  "secondLevelElements": "#9AA3B2",
  "thirdLevelElements": "#262A34",
  "fourthLevelElements": "#6B7280",
  "background": "#1C1F27",
