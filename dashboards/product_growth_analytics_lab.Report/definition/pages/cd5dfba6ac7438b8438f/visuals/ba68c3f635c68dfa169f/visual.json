                      "fontSize": "14pt",
                      "color": "#C8CDD6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Allocate the largest share of retention and loyalty budgets to ",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  },
                  {
                    "value": "Convert",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#C8CDD6"
                    }
                  },
                  {
                    "value": " customers to protect high-value revenue. Prioritize personalized cross-sell and upsell campaigns for ",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  },
                  {
                    "value": "Nurture",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#C8CDD6"
                    }
                  },
                  {
                    "value": " customers to increase lifetime value, while managing ",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  },
                  {
                    "value": "Low Priority",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#C8CDD6"
                    }
                  },
                  {
                    "value": " customers through automated, low-cost marketing. This investment strategy maximizes long-term revenue growth while improving marketing efficiency and return on investment.",
