table 'public order_fulfillment_funnel_mart'
	lineageTag: 89eea307-a2ee-4454-a4e1-cd7b34be36cd

	measure 'Total Orders Done' =
			
			DISTINCTCOUNT('public order_fulfillment_funnel_mart'[order_id])
		formatString: 0
		lineageTag: 8cfd809f-0f51-4cf5-8762-dd3cb3d0f663

	measure 'Total Revenue Done' =
			
			SUM('public order_fulfillment_funnel_mart'[payment_value])
		lineageTag: 7a9a3f21-005b-466b-8e43-534426b710eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delivered Orders' =
			
			SUM('public order_fulfillment_funnel_mart'[delivered_flag])
		formatString: 0
		lineageTag: 4bf41f34-7d17-4ee2-811e-ab35db97f899

	/// Share of in-scope orders delivered to the customer. Denominator matches the other funnel rates (Total Orders).
	measure 'Delivery Completion Rate' = DIVIDE ( [Delivered Orders], [Total Orders], 0 )
		formatString: 0.0%
		lineageTag: f6d665b2-8b68-426f-ba00-b7be9cd00257

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Orders' =
			
			SUM('public order_fulfillment_funnel_mart'[late_delivery_flag])
		formatString: 0
		lineageTag: 613976a1-8a03-467d-a8a7-e0ee624efc4a

	measure 'Late Delivery Rate' =
			
			DIVIDE([Late Orders], [Total Orders], 0)
		formatString: 0.0%
		lineageTag: 890ec6af-93ad-4aee-a724-ff3eaf68be6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Fulfillment Days' =
			
			AVERAGE('public order_fulfillment_funnel_mart'[fulfillment_days])
		lineageTag: 7b793e1a-223f-45ed-bec6-08f73fe4df54

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Review Score' =
			
			AVERAGE('public order_fulfillment_funnel_mart'[review_score])
		lineageTag: b16d889d-873f-49ac-92db-b121a353cb33

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Delivery Days' =
			
			AVERAGE('public order_fulfillment_funnel_mart'[delivery_days])
		lineageTag: 21d5dc2b-823a-4b60-a22a-c6a6c0a96ebb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Processing Days' =
			
			AVERAGE('public order_fulfillment_funnel_mart'[fulfillment_processing_days])
		lineageTag: 12fc87c1-502f-48d4-b02f-182834aa8f84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Approved Orders' =
			
			SUM('public order_fulfillment_funnel_mart'[approved_flag])
		formatString: 0
		lineageTag: 2f53d105-61b2-4656-bd0d-1c9d127c5313

	measure 'Approval Rate' =
			
			DIVIDE([Approved Orders], [Total Orders], 0)
		formatString: 0.0%
		lineageTag: ce12e25a-cf90-40f3-8f7a-488dc229cecd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Shipped Orders' =
			
			SUM('public order_fulfillment_funnel_mart'[shipped_flag])
		formatString: 0
		lineageTag: 4950b70a-eaf4-4bf8-9a68-20162aea6951

	measure 'Shipping Rate' =
			
			DIVIDE([Shipped Orders], [Total Orders], 0)
		formatString: 0.0%
		lineageTag: 0d0c5f46-dad9-4a5d-8696-95ca8f5b6947

		annotation PBI_FormatHint = {"isGeneralNumber":true}

