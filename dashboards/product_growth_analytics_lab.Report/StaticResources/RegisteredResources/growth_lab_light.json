    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#F4F6FB"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#F4F6FB"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#F4F6FB"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#9AA3B2"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#F4F6FB"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1C1F27"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A2E38"
              }
            },
            "radius": 6
          }
