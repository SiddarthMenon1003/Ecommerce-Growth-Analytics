          {
            "color": {
              "solid": {
                "color": "#F4F6FB"
              }
            },
            "fontSize": 18,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#9AA3B2"
              }
            },
            "fontSize": 9
          }
        ],
        "cardTitle": [
          {
            "color": {
              "solid": {
                "color": "#9AA3B2"
              }
            },
            "fontSize": 9
          }
