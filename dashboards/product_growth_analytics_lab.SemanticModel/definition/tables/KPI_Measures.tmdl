	measure 'MP High LTV Customers' =
			
			CALCULATE(
			    COUNTROWS('public marketing_roi_mart'),
			    'public marketing_roi_mart'[estimated_ltv]
			        > AVERAGE('public marketing_roi_mart'[estimated_ltv])
			)
		formatString: 0
		displayFolder: Marketing Performance
		lineageTag: cd59c746-8add-4ecd-8853-d94e412c5083

	measure 'MP High LTV %' =
			
			DIVIDE(
			    [MP High LTV Customers],
