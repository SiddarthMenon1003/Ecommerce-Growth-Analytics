	/// Prior-month value of [Monthly Active Customers] - KPI goal for month-over-month comparison.
	measure 'Active Customers Goal' = CALCULATE ( [Monthly Active Customers], DATEADD ( 'Dim Date'[Date], -1, MONTH ) )
