                      "color": "#C8CDD6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Convert customers generate the highest revenue despite representing the smallest customer segment, making them the highest-return marketing investment.",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Nurture customers account for a large share of the customer base and represent the strongest opportunity for lifetime value expansion through targeted upsell campaigns.",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Low Priority customers contribute comparatively limited revenue and should be managed using scalable, automated engagement strategies.",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Marketing resources should be allocated based on expected customer lifetime value rather than customer volume to maximize long-term ROI.",
                    "textStyle": {
                      "color": "#C8CDD6"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
