	measure 'MP Primary Investment' =
			
			VAR TopPriority =
			    TOPN(
			        1,
			        SUMMARIZE(
			            'public marketing_roi_mart',
			            'public marketing_roi_mart'[marketing_priority],
			            "Revenue", SUM('public marketing_roi_mart'[total_revenue])
			        ),
			        [Revenue], DESC
			    )
			RETURN
			    MAXX(TopPriority, 'public marketing_roi_mart'[marketing_priority])
		displayFolder: Marketing Performance
		lineageTag: c73e0fda-d1f6-411e-b72f-fb194c6a3132

