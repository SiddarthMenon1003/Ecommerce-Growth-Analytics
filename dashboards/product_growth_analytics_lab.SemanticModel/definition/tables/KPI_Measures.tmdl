	measure 'RG Total Revenue' = SUM('public revenue_growth_mart'[monthly_revenue])
		formatString: "R$"#,0
		displayFolder: Revenue Growth
		lineageTag: a505d2d2-6efc-4222-a530-5b98a08d851f

	measure 'RG Total Orders' = SUM('public revenue_growth_mart'[monthly_orders])
		formatString: #,0
