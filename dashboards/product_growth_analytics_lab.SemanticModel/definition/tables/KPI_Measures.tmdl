	/// Prior-month value of [Total Revenue] - KPI goal for month-over-month comparison.
	measure 'Total Revenue Goal' = CALCULATE ( [Total Revenue], DATEADD ( 'Dim Date'[Date], -1, MONTH ) )
		formatString: "R$"#,0
		displayFolder: KPI Goals
		lineageTag: 980e4c17-4825-4b08-a265-e6c6bcacfcf3

	/// Prior-month value of [Total Orders] - KPI goal for month-over-month comparison.
	measure 'Total Orders Goal' = CALCULATE ( [Total Orders], DATEADD ( 'Dim Date'[Date], -1, MONTH ) )
