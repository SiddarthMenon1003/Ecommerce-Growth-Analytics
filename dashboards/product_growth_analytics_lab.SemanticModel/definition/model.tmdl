model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Dim Customers","Dim Products","Dim Sellers","Fact Order Items","Fact Orders","Fact Payments","Fact Reviews","KPI_Measures","public customer_cohorts","public customer_value_mart","public marketing_roi_mart","public customer_segmentation_mart","public order_fulfillment_funnel_mart","public revenue_growth_mart","public customer_rfm_segments"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table 'Dim Customers'
ref table 'Dim Products'
ref table 'Dim Sellers'
ref table 'Fact Order Items'
ref table 'Fact Orders'
ref table 'Fact Payments'
ref table 'Fact Reviews'
ref table KPI_Measures
ref table 'Dim Date'
ref table 'Revenue Share'
ref table 'Purchase Frequency'
ref table 'Customer Type'
ref table 'public customer_cohorts'
ref table 'public customer_value_mart'
ref table 'public marketing_roi_mart'
ref table 'public customer_segmentation_mart'
ref table 'public order_fulfillment_funnel_mart'
ref table 'public revenue_growth_mart'
ref table 'public customer_rfm_segments'

ref cultureInfo en-US

