              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#9AA3B2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1C1F27"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#9AA3B2"
              }
            },
            "backColorSecondary": {
